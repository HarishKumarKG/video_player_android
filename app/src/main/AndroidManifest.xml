<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+: read the videos on the device -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Android 12 and below: same, through the old storage permission -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Renaming folders: "All files access", switched on once by the user in Settings -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 13+: needed to show the playback notification (background audio) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keeps the CPU awake while audio plays in the background with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Casting to a TV. Only used on your own Wi-Fi: the TV downloads the video from the
        phone's little built-in server, and the app finds TVs with Google Cast / DLNA.
        Nothing is sent to the internet.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17+: asked the first time you tap the Cast button -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".VideoPlayerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.VideoPlayer"
        tools:targetApi="31">
        <!--
            configChanges: rotating the phone or entering picture-in-picture must NOT recreate the
            activity, otherwise the video surface would be torn down and the picture would flicker.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.VideoPlayer"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Cast setup (Chromecast / Google TV) -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.harish.videoplayer.cast.googlecast.CastOptionsProvider" />

        <!-- Keeps casting (and the phone's video server) running with the screen off -->
        <service
            android:name=".cast.CastService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Media3 session service: notification, lock screen, headset & Bluetooth buttons -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
